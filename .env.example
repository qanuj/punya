# The CMS this site reads from, and a delivery key for it.
# Settings > API keys in the CMS issues the key.
TINTORCH_CMS_URL=https://cms.tintorch.com
TINTORCH_CMS_KEY=

# Where this site is served from. Used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only if your CMS stores media somewhere other than media.tintorch.com.
# NEXT_PUBLIC_MEDIA_HOST=media.tintorch.com

# Sign-in, through TinTorch Account. Register the client with
# <NEXT_PUBLIC_SITE_URL>/auth/callback as its redirect URI.
#
# The secret is server-only - no NEXT_PUBLIC_ prefix - and must not be committed.
TINTORCH_ISSUER=https://account.tintorch.com
TINTORCH_CLIENT_ID=
TINTORCH_CLIENT_SECRET=

# Razorpay, for donations. Settings > API keys in the Razorpay dashboard.
# Both are server-only - no NEXT_PUBLIC_ prefix - and must not be committed.
# Without them /donate renders and says online giving is not switched on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shared secret for POST /api/revalidate, which the CMS calls when content or
# settings change. Without it the endpoint answers 501 and every change waits
# out the page's own revalidate window instead. Set the same value in the CMS
# under Settings > Site > Webhook.
REVALIDATE_SECRET=
