# The CMS this site reads from, and a delivery key for it.
# Settings > API keys in the CMS issues the key.
TINTORCH_CMS_URL=https://cms.tintorch.com
TINTORCH_CMS_KEY=

# Where this site is served from. Used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only if your CMS stores media somewhere other than media.tintorch.com.
# NEXT_PUBLIC_MEDIA_HOST=media.tintorch.com

# Sign-in, through TinTorch Account. Register the client with
# <NEXT_PUBLIC_SITE_URL>/auth/callback as its redirect URI.
#
# The secret is server-only - no NEXT_PUBLIC_ prefix - and must not be committed.
TINTORCH_ISSUER=https://account.tintorch.com
TINTORCH_CLIENT_ID=
TINTORCH_CLIENT_SECRET=

# Razorpay, for donations. Settings > API keys in the Razorpay dashboard.
# Both are server-only - no NEXT_PUBLIC_ prefix - and must not be committed.
# Without them /donate renders and says online giving is not switched on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shared secret for POST /api/revalidate, which the CMS calls when content or
# settings change. Without it the endpoint answers 501 and every change waits
# out the page's own revalidate window instead. Set the same value in the CMS
# under Settings > Site > Webhook.
REVALIDATE_SECRET=

# Ways to give that do not go through Razorpay. Each block is optional: a
# method with nothing set does not appear on /donate at all.
#
# UPI. The QR is built from these, so any UPI app opens with the payee filled in.
GIVE_UPI_ID=
GIVE_UPI_NAME=
#
# Bank transfer. Account number and IFSC are both required for the card to show.
GIVE_BANK_ACCOUNT_NAME=
GIVE_BANK_ACCOUNT_NUMBER=
GIVE_BANK_IFSC=
GIVE_BANK_NAME=
GIVE_BANK_BRANCH=
# Only needed for a transfer from outside India, which is an FCRA question first.
GIVE_BANK_SWIFT=
#
# Wallet addresses, one per line as `Label | address`.
#
# The label must name the network. It is the only thing on the page telling a
# donor which chain to send on, and a transfer on the wrong one cannot be
# recovered. USDT is not one thing: the TRON address starts T, the BNB Smart
# Chain and Ethereum ones start 0x.
#
# Copy each address from Trust Wallet: pick the coin, tap Receive, copy. Leave
# the ones you are not offering as they are - an entry whose address does not
# have the shape of a real address is dropped rather than shown, so this can
# sit here half-filled without ever showing a donor a placeholder to pay into.
#
# No FCRA registration means the trust cannot lawfully accept a foreign
# contribution, and a public wallet address accepts money from anywhere with
# nothing in between. Leave this empty until that is settled.
GIVE_CRYPTO="USDT (TRON, TRC20) | PASTE_TRON_ADDRESS_HERE
USDT (BNB Smart Chain, BEP20) | PASTE_BSC_ADDRESS_HERE
Bitcoin | PASTE_BITCOIN_ADDRESS_HERE
Ethereum (ERC20) | PASTE_ETHEREUM_ADDRESS_HERE
BNB (BNB Smart Chain) | PASTE_BNB_ADDRESS_HERE
Solana | PASTE_SOLANA_ADDRESS_HERE""USDT (TRON, TRC20) | TX...
#   Bitcoin | bc1..."
GIVE_CRYPTO=
