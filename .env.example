# The CMS this site reads from, and a delivery key for it.
# Settings > API keys in the CMS issues the key.
TINTORCH_CMS_URL=https://cms.tintorch.com
TINTORCH_CMS_KEY=

# Where this site is served from. Used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only if your CMS stores media somewhere other than media.tintorch.com.
# NEXT_PUBLIC_MEDIA_HOST=media.tintorch.com
